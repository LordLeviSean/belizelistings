# BelizeListings — environment variables
# Copy this file to `.env.local` and fill in values. Never commit `.env.local`.

# -----------------------------------------------------------------------------
# Supabase (required)
# Project Settings → API in the Supabase dashboard.
# NEXT_PUBLIC_* vars are exposed to the browser (safe for anon key only).
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never prefix with NEXT_PUBLIC_.
# Settings → API → service_role (secret). Required for admin API routes and scripts
# (create user, permanent user delete auth removal, storage cleanup, cron).
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Database & migrations (optional — scripts/apply-supabase-migrations.mjs)
# Use DATABASE_URL (pooler) or DIRECT_URL (direct Postgres). One is enough.
# -----------------------------------------------------------------------------

# DATABASE_URL=
# DIRECT_URL=

# Personal access token for Supabase Management API (alternative to DATABASE_URL).
# https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Feature flags (optional — NEXT_PUBLIC_* inlined at build time)
# -----------------------------------------------------------------------------

# User dashboard inquiries metric + realtime. Default when unset: disabled.
# Set to 1 or true after listing_inquiries exists in PostgREST.
# Stage 1 — marketplace activation v1.6.5
# NEXT_PUBLIC_BL_ENABLE_INQUIRIES=

# CRM conversations + agent inbox v2 + RPC lead capture. Default when unset: disabled.
# Stage 2 — marketplace activation v1.6.5 (requires Stage 1)
# NEXT_PUBLIC_BL_ENABLE_CONVERSATIONS=

# Persist ListingViewingBookingModal to viewing_requests. Default when unset: disabled.
# Stage 3 — marketplace activation v1.6.5 (requires Stage 2)
# NEXT_PUBLIC_BL_ENABLE_VIEWING_PERSIST=

# Durable in-app notifications inbox + queue delivery. Default when unset: disabled.
# Stage 4 — notification delivery v1.6.6 (requires Stages 1–3 + notification migration)
# NEXT_PUBLIC_BL_ENABLE_NOTIFICATIONS=

# Cron secret for /api/cron/process-notifications (required in production — cron fails closed when unset)
# CRON_SECRET=

# Guest lead protection — Cloudflare Turnstile (Milestone 3.7 v1.6.7)
# NEXT_PUBLIC_BL_ENABLE_TURNSTILE=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Email provider for future transactional delivery (MVP marks channel skipped when unset)
# RESEND_API_KEY=

# Append/read listing_events (Property History timeline). Default when unset: disabled.
# Set to 1 or true after listing_events migration is applied. Required on Netlify for production.
# NEXT_PUBLIC_BL_ENABLE_LISTING_EVENTS=

# Skip favorites count probe on user dashboard. Set to 1 to enable skip.
# NEXT_PUBLIC_BL_SKIP_USER_DASHBOARD_FAVORITES_COUNT=

# Override per-tier listing cap for QA/beta (numeric string, e.g. 10).
# NEXT_PUBLIC_BETA_LISTING_CAP_OVERRIDE=

# -----------------------------------------------------------------------------
# Debugging (optional)
# -----------------------------------------------------------------------------

# Log trace actions in the browser console. Default: false
NEXT_PUBLIC_TRACE_ACTIONS=false

# Canonical site URL fallback for QA scripts when QA_BASE_URL is unset.
# NEXT_PUBLIC_SITE_URL=

# -----------------------------------------------------------------------------
# QA & automation (optional — npm run qa, scripts/qa/*, screenshot scripts)
# -----------------------------------------------------------------------------

# Base URL for Playwright/Lighthouse QA (default: https://belizelistings.bz or localhost).
# QA_BASE_URL=

# Credentials for signed-in QA flows (skipped gracefully when unset).
# QA_EMAIL=
# QA_PASSWORD=

# Alternate names read by some repro scripts if QA_* are unset.
# NEXT_PUBLIC_QA_EMAIL=
# TEST_EMAIL=
# TEST_PASSWORD=
