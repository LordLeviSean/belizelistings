# Staging E2E credentials — copy to `.env.test.local` (gitignored). Never commit real passwords.

# Target deployment (staging preferred)
E2E_BASE_URL=https://your-staging-site.netlify.app

# --- Required accounts (create in Supabase Auth; assign roles in profiles) ---

# Buyer — sends messages, requests viewings, accepts reschedule
E2E_BUYER_EMAIL=
E2E_BUYER_PASSWORD=

# Owner — listing owner with published inventory; receives inquiries/viewings
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=

# Agent (optional) — dedicated agent dashboard coverage
E2E_AGENT_EMAIL=
E2E_AGENT_PASSWORD=

# Admin (optional) — /admin CRM surfaces
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# --- Listing fixtures (numeric listing IDs on staging) ---

# Published listing owned by E2E_OWNER — used for Flows A & B
E2E_PUBLISHED_LISTING_ID=

# Separate listing owner can mark recently sold/rented — Flow C only
E2E_CLOSABLE_LISTING_ID=

# --- Optional: notification cron verification (server-side scripts only) ---

# CRON_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=   # already in .env.local for local scripts

# --- Staging feature flags (set in Netlify, not here — build-time) ---
# NEXT_PUBLIC_BL_ENABLE_INQUIRIES=1
# NEXT_PUBLIC_BL_ENABLE_CONVERSATIONS=1
# NEXT_PUBLIC_BL_ENABLE_VIEWING_PERSIST=1
# NEXT_PUBLIC_BL_ENABLE_NOTIFICATIONS=1
# NEXT_PUBLIC_BL_ENABLE_LISTING_EVENTS=1
